---
import type { TransitionAnimationPair } from 'astro';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import Footer from '../components/organisms/Footer.astro';
import Header from '../components/organisms/Header.astro';
import StructuredData from '../components/StructuredData.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { SITE_AUTHOR, SITE_JOB_TITLE } from '../consts';
import { getPagePath } from '../utils/getPagePath';
import '../styles/global.css';

type Background = 'dots' | 'stripes';

interface Props {
  title: string;
  description: string;
  background?: Background;
  image?: string;
  /** Keep the page out of search results (and omit its canonical). */
  noindex?: boolean;
}

const {
  title,
  description,
  background: backgroundProp,
  image = '/og.png',
  noindex = false,
} = Astro.props;

const pageTitle = `${title} — ${SITE_AUTHOR}`;
const canonicalUrl = new URL(getPagePath(Astro.url.pathname), Astro.site);
const imageUrl = new URL(image, Astro.site);

const background: Background = backgroundProp ?? 'dots';

const backgroundClasses: Record<Background, string> = {
  dots: 'bg-dot-grid',
  stripes: 'bg-stripes',
};

const pageTransition: TransitionAnimationPair = {
  old: {
    name: 'fade-out',
    duration: '420ms',
    easing: 'ease-out',
    fillMode: 'both',
  },
  new: {
    name: 'fade-up',
    duration: '420ms',
    easing: 'ease-out',
    fillMode: 'both',
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={canonicalUrl} />
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={SITE_AUTHOR} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${SITE_AUTHOR}, ${SITE_JOB_TITLE}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- ThemeScript keeps this in sync with the active theme. -->
    <meta name="theme-color" content="#fff4e0" />
    <StructuredData />
    <ThemeScript />
    <Font cssVariable="--font-bricolage-grotesque" preload />
    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-space-mono" />
    <ClientRouter />
    <Analytics />
  </head>
  <body
    class:list={[
      'flex min-h-dvh flex-col has-[dialog[open]]:overflow-hidden',
      backgroundClasses[background],
    ]}
  >
    <a
      href="#main"
      class="sr-only rounded-sm border-2 border-border bg-surface px-4 py-2 font-display font-bold shadow-sm focus-ring focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-50"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="main"
      class="flex-1"
      transition:animate={{
        forwards: pageTransition,
        backwards: pageTransition,
      }}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.dataset.clientNavigated = '';
  });
</script>
