---
import type { TransitionAnimationPair } from 'astro';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import Footer from '../components/organisms/Footer.astro';
import Header from '../components/organisms/Header.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { SITE_AUTHOR } from '../consts';
import '../styles/global.css';

type Background = 'dots' | 'stripes';

interface Props {
  title: string;
  description: string;
  background?: Background;
}

const { title, description, background: backgroundProp } = Astro.props;

const background: Background = backgroundProp ?? 'dots';

const backgroundClasses: Record<Background, string> = {
  dots: 'bg-dot-grid',
  stripes: 'bg-stripes',
};

const pageTransition: TransitionAnimationPair = {
  old: {
    name: 'fade-out',
    duration: '420ms',
    easing: 'ease-out',
    fillMode: 'both',
  },
  new: {
    name: 'fade-up',
    duration: '420ms',
    easing: 'ease-out',
    fillMode: 'both',
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{`${title} — ${SITE_AUTHOR}`}</title>
    <meta name="description" content={description} />
    <ThemeScript />
    <Font cssVariable="--font-bricolage-grotesque" preload />
    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-space-mono" />
    <ClientRouter />
    <Analytics />
  </head>
  <body
    class:list={[
      'flex min-h-dvh flex-col has-[dialog[open]]:overflow-hidden',
      backgroundClasses[background],
    ]}
  >
    <a
      href="#main"
      class="sr-only rounded-sm border-2 border-border bg-surface px-4 py-2 font-display font-bold shadow-sm focus-ring focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-50"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="main"
      class="flex-1"
      transition:animate={{
        forwards: pageTransition,
        backwards: pageTransition,
      }}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.dataset.clientNavigated = '';
  });
</script>
