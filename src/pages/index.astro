---
import Hero from '../components/organisms/Hero.astro';
import Marquee from '../components/organisms/Marquee.astro';
import Layout from '../layouts/Layout.astro';

const marqueeItems = [
  'TypeScript',
  'Shopify',
  'Vue.js',
  'Nuxt',
  'Tailwind CSS',
  'Modern CSS',
  'Accessibility',
];
---

<Layout title="Home">
  <Hero />
  <Marquee items={marqueeItems} />
</Layout>
