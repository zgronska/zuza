---
import Hero from '../components/organisms/Hero.astro';
import Marquee from '../components/organisms/Marquee.astro';
import Layout from '../layouts/Layout.astro';

const marqueeItems = [
  'TypeScript',
  'Shopify',
  'Vue.js',
  'Nuxt',
  'Tailwind CSS',
  'Modern CSS',
  'Accessibility',
];
---

<Layout
  description="Zuza Gronska is a creative frontend developer in the Netherlands, building accessible, modern UIs with Vue.js, Nuxt, TypeScript, Shopify and modern CSS."
>
  <Hero />
  <Marquee items={marqueeItems} />
</Layout>
