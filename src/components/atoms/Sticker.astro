---
import type { HTMLAttributes } from 'astro/types';
import { toneClasses } from '../../utils/toneClasses';

type Props = HTMLAttributes<'span'>;

const { class: className, ...attrs } = Astro.props;
---

<span
  class:list={[
    'inline-flex -rotate-3 items-center gap-2 rounded-full border-3 border-border px-4 py-2 text-label shadow-md',
    toneClasses.accent,
    className,
  ]}
  {...attrs}
>
  <slot />
</span>
