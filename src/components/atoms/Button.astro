---
import type { HTMLAttributes } from 'astro/types';
import { getActionAttrs } from '../../utils/getActionAttrs';
import ExternalIndicator from './ExternalIndicator.astro';

type Variant = 'primary' | 'accent' | 'ghost';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  variant?: Variant;
  external?: boolean;
  type?: 'button' | 'submit' | 'reset';
}

const {
  variant: variantProp,
  external = false,
  href,
  type = 'button',
  class: className,
  ...attrs
} = Astro.props;

const variant: Variant = variantProp ?? 'primary';
const Tag = href ? 'a' : 'button';

const variantClasses: Record<Variant, string> = {
  primary:
    'bg-primary text-primary-foreground hover:bg-primary-hover active:bg-primary-active focus-visible:outline-primary-focus',
  accent:
    'bg-accent text-accent-foreground hover:bg-accent-hover active:bg-accent-active',
  ghost:
    'bg-surface text-foreground hover:bg-background active:bg-background focus-visible:outline-primary-focus',
};

const actionAttrs = getActionAttrs({ href, external, type });
---

<Tag
  class:list={[
    'inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 rounded-sm border-3 border-border px-6 py-3 font-display leading-tight font-bold shadow-md focus-ring transition-lift hover:shadow-lg active:shadow-none motion-safe:hover:-translate-0.5 motion-safe:active:translate-1 [&>svg]:shrink-0',
    variantClasses[variant],
    className,
  ]}
  {...actionAttrs}
  {...attrs}
>
  <slot />
  {external && <ExternalIndicator />}
</Tag>
