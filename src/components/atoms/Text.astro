---
import type { HTMLAttributes } from 'astro/types';

type Size = 'lead' | 'body';

interface Props extends HTMLAttributes<'p'> {
  size?: Size;
  muted?: boolean;
}

const {
  size: sizeProp,
  muted = false,
  class: className,
  ...attrs
} = Astro.props;

const size: Size = sizeProp ?? 'body';

const sizeClasses: Record<Size, string> = {
  lead: 'text-lg',
  body: 'text-base',
};
---

<p
  class:list={[
    'max-w-prose text-pretty',
    sizeClasses[size],
    { 'text-muted-foreground': muted },
    className,
  ]}
  {...attrs}
>
  <slot />
</p>
