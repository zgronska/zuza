---
import type { HTMLAttributes } from 'astro/types';
import { toneClasses, type Tone } from '../../utils/toneClasses';

type Variant = Extract<Tone, 'primary' | 'accent'>;

interface Props extends HTMLAttributes<'span'> {
  variant?: Variant;
}

const { variant: variantProp, class: className, ...attrs } = Astro.props;

const variant: Variant = variantProp ?? 'primary';
---

<span
  class:list={[
    'inline-block rounded-sm border-3 border-border px-[0.15em] shadow-sm',
    toneClasses[variant],
    className,
  ]}
  {...attrs}
>
  <slot />
</span>
