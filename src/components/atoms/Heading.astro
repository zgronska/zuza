---
import type { Polymorphic } from 'astro/types';

type HeadingTag = 'h1' | 'h2' | 'p';
type Size = 'hero' | 'display' | 'title';

type Props<Tag extends HeadingTag> = Polymorphic<{ as: Tag }> & {
  size: Size;
};

const {
  as: Tag = 'h2',
  size: sizeProp,
  class: className,
  ...attrs
} = Astro.props;

const size: Size = sizeProp;

const sizeClasses: Record<Size, string> = {
  hero: 'text-5xl font-extrabold leading-none tracking-tighter md:text-hero',
  display: 'text-display font-extrabold leading-none tracking-tighter',
  title: 'text-2xl font-bold tracking-tight',
};
---

<Tag
  class:list={['font-display text-balance', sizeClasses[size], className]}
  {...attrs}
>
  <slot />
</Tag>
