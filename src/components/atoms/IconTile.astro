---
import type { HTMLAttributes } from 'astro/types';
import { toneClasses, type Tone } from '../../utils/toneClasses';

type IconTileTone = Extract<Tone, 'surface' | 'highlight'>;

interface Props extends HTMLAttributes<'span'> {
  tone?: IconTileTone;
}

const { tone: toneProp, class: className, ...attrs } = Astro.props;

const tone: IconTileTone = toneProp ?? 'highlight';
---

<span
  class:list={[
    'inline-flex size-11 shrink-0 items-center justify-center rounded-sm border-2 border-border shadow-sm',
    toneClasses[tone],
    className,
  ]}
  aria-hidden="true"
  {...attrs}
>
  <slot />
</span>
