---
import { SITE_AUTHOR } from '../consts';

const currentYear = new Date().getFullYear();
---

<footer class="border-t-3 border-border bg-highlight text-highlight-foreground">
  <div
    class="site-container flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-6"
  >
    <small class="text-sm"
      >© {currentYear} {SITE_AUTHOR}. All rights reserved.</small
    >
    <p class="font-mono text-xs font-bold tracking-widest uppercase">
      Built with Astro + Tailwind
    </p>
  </div>
</footer>
