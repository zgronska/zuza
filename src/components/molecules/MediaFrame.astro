---
import { Image as ImageIcon } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import Eyebrow from '../atoms/Eyebrow.astro';

interface Props extends HTMLAttributes<'div'> {
  label: string;
  image?: ImageMetadata;
  priority?: boolean;
}

const {
  label,
  image,
  priority = false,
  class: className,
  ...attrs
} = Astro.props;
---

<div class:list={['relative', className]} {...attrs}>
  <div
    role={image ? undefined : 'img'}
    aria-label={image ? undefined : label}
    class="relative flex aspect-4/5 flex-col items-center justify-center gap-4 overflow-hidden rounded-lg border-3 border-border bg-surface text-muted-foreground shadow-lg"
  >
    {
      image ? (
        <Image
          src={image}
          alt={label}
          width={960}
          widths={[320, 480, 640, 960]}
          sizes="(min-width: 80rem) 32rem, (min-width: 48rem) 40vw, 20rem"
          priority={priority}
          class="size-full object-cover"
        />
      ) : (
        <>
          <ImageIcon size={48} />
          <Eyebrow as="span">{label}</Eyebrow>
        </>
      )
    }
  </div>
  {
    Astro.slots.has('sticker') && (
      <div class="absolute -top-5 -right-2 md:-right-4">
        <slot name="sticker" />
      </div>
    )
  }
</div>
