---
import type { Polymorphic } from 'astro/types';

type CardTag = 'div' | 'article' | 'li';
type Tone = 'surface' | 'primary' | 'accent' | 'highlight';

type Props<Tag extends CardTag> = Polymorphic<{ as: Tag }> & {
  tone?: Tone;
  hoverable?: boolean;
  elevated?: boolean;
};

const {
  as: Tag = 'div',
  tone: toneProp,
  hoverable: hoverableProp,
  elevated: elevatedProp,
  class: className,
  ...attrs
} = Astro.props;

const tone: Tone = toneProp ?? 'surface';
const hoverable: boolean = hoverableProp ?? true;
const elevated: boolean = elevatedProp ?? false;

const toneClasses: Record<Tone, string> = {
  surface: 'bg-surface text-foreground',
  primary: 'bg-primary text-primary-foreground',
  accent: 'bg-accent text-accent-foreground',
  highlight: 'bg-highlight text-highlight-foreground',
};
---

<Tag
  class:list={[
    'rounded-lg border-3 border-border p-6',
    elevated ? 'shadow-xl' : 'shadow-md',
    {
      'hover:shadow-lg motion-safe:transition-[translate,box-shadow] motion-safe:duration-200 motion-safe:ease-out motion-safe:hover:-translate-0.5':
        hoverable,
    },
    toneClasses[tone],
    className,
  ]}
  {...attrs}
>
  <slot />
</Tag>
