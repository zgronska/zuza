---
import { SITE_AUTHOR } from '../../consts';
import Button from '../atoms/Button.astro';
import Eyebrow from '../atoms/Eyebrow.astro';
import Heading from '../atoms/Heading.astro';
import Highlight from '../atoms/Highlight.astro';
import MediaFrame from '../molecules/MediaFrame.astro';

const headingId = 'hero-title';
---

<section
  aria-labelledby={headingId}
  class="site-container grid items-center gap-12 py-12 md:grid-cols-12 md:py-20"
>
  <div class="flex flex-col items-start gap-6 md:col-span-7">
    <Eyebrow variant="chip">01 / Hello</Eyebrow>
    <Heading as="h1" size="hero" id={headingId}>
      Hi, I am <Highlight>{SITE_AUTHOR}</Highlight>
    </Heading>
    <Heading as="p" size="title">Creative Frontend Developer</Heading>
    <Button href="/contact" variant="accent">Get in touch</Button>
  </div>

  <MediaFrame
    variant="illustration"
    label="TODO"
    class="w-full max-w-80 justify-self-center md:col-span-5 md:max-w-none"
  />
</section>
