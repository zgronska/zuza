---
import LineShape from '../atoms/LineShape.astro';
import StarShape from '../atoms/StarShape.astro';

// Decorative Hardline shapes layered behind the hero type. Phones keep only the
// circle, star and squiggle, tucked into the corners clear of the text.
const block = 'absolute block border-3 border-border';
const pop = 'absolute stagger-pop';
const drift = 'motion-safe:animate-drift';
---

<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
  <!-- Big periwinkle circle, behind the end of the name -->
  <span
    class={`${pop} -top-2 -right-6 w-28 sm:w-40 lg:top-[8%] lg:right-[3%] lg:w-[clamp(12rem,24vw,21rem)]`}
    style="--stagger-index: 0"
  >
    <span
      class={`${block} relative aspect-square w-full rounded-full bg-accent shadow-lg ${drift}`}
    ></span>
  </span>

  <!-- Surface card leaning on the circle -->
  <span
    class={`${pop} max-lg:hidden lg:right-[14%] lg:bottom-[14%] lg:h-[22%] lg:w-[clamp(10rem,18vw,16rem)]`}
    style="--stagger-index: 1"
  >
    <span
      class={`${block} relative size-full rotate-6 rounded-lg bg-surface shadow-md`}
    ></span>
  </span>

  <!-- Yellow square -->
  <span
    class={`${pop} max-lg:hidden lg:top-[4%] lg:right-[34%] lg:w-[clamp(3.5rem,6vw,5.5rem)]`}
    style="--stagger-index: 2"
  >
    <span
      class={`${block} relative aspect-square w-full rotate-12 bg-highlight shadow-md`}
    ></span>
  </span>

  <!-- Star, slow spin -->
  <span
    class={`${pop} top-10 right-32 w-10 sm:top-16 sm:right-52 lg:top-[2%] lg:right-auto lg:left-[34%] lg:w-[clamp(3rem,5vw,4.5rem)]`}
    style="--stagger-index: 3"
  >
    <StarShape class="motion-safe:animate-spin-slow" />
  </span>

  <!-- Small star near the zigzag -->
  <span
    class={`${pop} max-lg:hidden lg:right-[4%] lg:bottom-[6%] lg:w-10`}
    style="--stagger-index: 4"
  >
    <StarShape tone="highlight" />
  </span>

  <!-- Squiggle -->
  <span
    class={`${pop} right-4 bottom-12 w-24 lg:top-[28%] lg:right-auto lg:bottom-auto lg:left-[39%] lg:w-[clamp(6rem,10vw,9rem)]`}
    style="--stagger-index: 5"
  >
    <LineShape variant="squiggle" class={drift} />
  </span>

  <!-- Zigzag -->
  <span
    class={`${pop} max-lg:hidden lg:right-[20%] lg:-bottom-[2%] lg:w-[clamp(7rem,12vw,11rem)]`}
    style="--stagger-index: 6"
  >
    <LineShape variant="zigzag" tone="primary" />
  </span>

  <!-- Ring -->
  <span
    class={`${pop} max-lg:hidden lg:top-[30%] lg:right-[1%] lg:w-12`}
    style="--stagger-index: 7"
  >
    <span
      class={`${block} relative aspect-square w-full rounded-full bg-surface shadow-sm`}
    ></span>
  </span>
</div>
