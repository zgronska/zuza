---
import { Menu, X } from '@lucide/astro';
import { NAV_LINKS, SOCIAL_LINKS } from '../../consts';
import { isCurrentPage } from '../../utils/isCurrentPage';
import IconButton from '../atoms/IconButton.astro';
import ThemeToggle from '../molecules/ThemeToggle.astro';
import Wordmark from '../molecules/Wordmark.astro';
import MobileMenu from './MobileMenu.astro';

const mobileMenuId = 'mobile-menu';

function getNavLabelTransitionName(href: string) {
  const slug = href.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '');

  return `nav-label-${slug || 'home'}`;
}
---

<header
  class="sticky top-4 z-40 site-container mt-4"
  transition:name="site-header"
  transition:animate="none"
>
  <div
    class="flex items-center justify-between gap-4 rounded-full border-3 border-border bg-surface py-2 pr-2 pl-3 text-foreground shadow-md"
  >
    <Wordmark />

    <nav aria-label="Main" class="max-lg:hidden">
      <ul class="flex gap-1">
        {
          NAV_LINKS.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-current={
                  isCurrentPage(Astro.url.pathname, href) ? 'page' : undefined
                }
                class="relative isolate inline-flex min-h-11 items-center rounded-full border-2 border-transparent px-4.5 py-2 font-display font-bold focus-ring transition-lift hover:border-border hover:shadow-sm aria-[current=page]:text-accent-foreground motion-safe:hover:-translate-px"
              >
                {isCurrentPage(Astro.url.pathname, href) && (
                  <span
                    class="absolute -inset-0.5 -z-10 rounded-full border-2 border-border bg-accent shadow-sm"
                    aria-hidden="true"
                    transition:name="nav-active"
                  />
                )}
                <span
                  class="[view-transition-class:nav-label]"
                  transition:name={getNavLabelTransitionName(href)}
                >
                  {label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {
        Object.values(SOCIAL_LINKS).map(({ label, href }) => (
          <IconButton href={href} external class="max-lg:hidden">
            {label}
          </IconButton>
        ))
      }
      <ThemeToggle />
      <IconButton
        round
        aria-label="Menu"
        aria-expanded="false"
        aria-controls={mobileMenuId}
        data-menu-toggle
        class="group lg:hidden"
      >
        <Menu size={20} aria-hidden="true" class="group-aria-expanded:hidden" />
        <X
          size={20}
          aria-hidden="true"
          class="not-group-aria-expanded:hidden"
        />
      </IconButton>
    </div>
  </div>
  <MobileMenu id={mobileMenuId} />
</header>
