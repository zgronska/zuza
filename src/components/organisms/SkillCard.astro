---
import { Accessibility, Code, Layers, Wrench } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import Heading from '../atoms/Heading.astro';
import IconTile from '../atoms/IconTile.astro';
import BadgeList from '../molecules/BadgeList.astro';
import Card from '../molecules/Card.astro';

type Skill = CollectionEntry<'skills'>['data'];

interface Props {
  skill: Skill;
  index: number;
}

const { skill, index } = Astro.props;

const skillIcons: Record<Skill['icon'], typeof Code> = {
  code: Code,
  layers: Layers,
  accessibility: Accessibility,
  wrench: Wrench,
};

const spanClasses: Record<Skill['span'], string> = {
  wide: 'md:col-span-7',
  narrow: 'md:col-span-5',
};

const SkillIcon = skillIcons[skill.icon];
---

<Card
  as="li"
  tone={skill.tone}
  class:list={['flex stagger flex-col gap-5', spanClasses[skill.span]]}
  style={`--stagger-index: ${index}`}
>
  <div class="flex items-center gap-3.5">
    <IconTile tone={skill.tone === 'highlight' ? 'surface' : 'highlight'}>
      <SkillIcon size={24} aria-hidden="true" />
    </IconTile>
    <Heading as="h2" size="title" class="flex-1">{skill.title}</Heading>
  </div>
  <BadgeList items={skill.items} size="lg" />
</Card>
