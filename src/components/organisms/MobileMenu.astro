---
import { NAV_LINKS, SOCIAL_LINKS, type SocialLinkKey } from '../../consts';
import { isCurrentPage } from '../../utils/isCurrentPage';
import Button from '../atoms/Button.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;

const socialVariants: Record<SocialLinkKey, 'ghost' | 'accent'> = {
  github: 'ghost',
  linkedin: 'accent',
};

const socialLinkEntries = Object.entries(SOCIAL_LINKS) as [
  SocialLinkKey,
  (typeof SOCIAL_LINKS)[SocialLinkKey],
][];
---

<dialog
  id={id}
  aria-label="Menu"
  data-mobile-menu
  class="fixed inset-0 -z-10 m-0 size-full max-h-none max-w-none overflow-y-auto border-0 bg-background pt-24 pb-4 text-foreground max-lg:open:flex lg:hidden"
>
  <div class="site-container flex flex-1 flex-col gap-8">
    <nav aria-label="Mobile">
      <ul class="flex flex-col gap-3.5">
        {
          NAV_LINKS.map(({ label, href }, index) => (
            <li>
              <a
                href={href}
                aria-current={
                  isCurrentPage(Astro.url.pathname, href) ? 'page' : undefined
                }
                class="flex items-center justify-between gap-4 rounded-lg border-3 border-border bg-surface px-5 py-3.5 font-display text-4xl font-extrabold tracking-tight shadow-md focus-ring transition-lift hover:bg-background hover:shadow-lg focus-visible:shadow-lg active:shadow-none aria-[current=page]:bg-accent aria-[current=page]:text-accent-foreground aria-[current=page]:hover:bg-accent-hover motion-safe:hover:-translate-0.5 motion-safe:focus-visible:-translate-0.5 motion-safe:active:translate-1"
              >
                <span>{label}</span>
                <span class="text-label" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-auto flex flex-wrap gap-3">
      {
        socialLinkEntries.map(([key, { label, href }]) => (
          <Button
            href={href}
            external
            variant={socialVariants[key]}
            class="flex-1 basis-32"
          >
            {label}
          </Button>
        ))
      }
    </div>
  </div>
</dialog>

<script>
  const hiddenMenuObserver = new ResizeObserver((entries) => {
    entries.forEach(({ target }) => {
      if (target instanceof HTMLDialogElement && !target.checkVisibility()) {
        closeMenu(target, { restoreFocus: false });
      }
    });
  });

  function getToggleFor(menu: HTMLDialogElement) {
    return document.querySelector<HTMLElement>(`[aria-controls="${menu.id}"]`);
  }

  function getMenuFor(toggle: Element) {
    const menuId = toggle.getAttribute('aria-controls');
    const menu = menuId ? document.getElementById(menuId) : null;

    return menu instanceof HTMLDialogElement ? menu : null;
  }

  function getOpenMenus() {
    return document.querySelectorAll<HTMLDialogElement>(
      'dialog[data-mobile-menu][open]',
    );
  }

  function setPageInert(menu: HTMLDialogElement, isInert: boolean) {
    Array.from(document.body.children).forEach((element) => {
      if (!element.contains(menu)) element.toggleAttribute('inert', isInert);
    });
  }

  function openMenu(menu: HTMLDialogElement) {
    menu.show();
    hiddenMenuObserver.observe(menu);
    getToggleFor(menu)?.setAttribute('aria-expanded', 'true');
    setPageInert(menu, true);
    menu.querySelector('a')?.focus();
  }

  function closeMenu(menu: HTMLDialogElement, { restoreFocus = true } = {}) {
    const toggle = getToggleFor(menu);

    menu.close();
    hiddenMenuObserver.unobserve(menu);
    toggle?.setAttribute('aria-expanded', 'false');
    setPageInert(menu, false);
    if (restoreFocus) toggle?.focus();
  }

  function closeOpenMenus() {
    getOpenMenus().forEach((menu) => closeMenu(menu, { restoreFocus: false }));
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    const toggle = event.target.closest('[data-menu-toggle]');
    const menu = toggle ? getMenuFor(toggle) : null;
    if (!menu) return;

    if (menu.open) closeMenu(menu);
    else openMenu(menu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape')
      getOpenMenus().forEach((menu) => closeMenu(menu));
  });

  document.addEventListener('astro:before-preparation', closeOpenMenus);
</script>
